# 로컬 개발 환경 변수 견본.
#
#   cp .env.example .env
#
# .env 는 .gitignore 에 있어 커밋되지 않는다. 이 파일은 커밋된다 —
# 값이 아니라 "무엇이 필요한지"를 남기는 것이 목적이다.

# ─── 모델 ──────────────────────────────────────────────────────────────
# fake | gemini | anthropic. 기본은 fake 다.
#
# **Fake 로도 게임 전체가 돈다.** 판단이 LLM 보다 단순할 뿐 규칙·로그·인스펙터는
# 동일하다(기획서 §9 추가①). 자격증명 없이 배포해도 방문자는 한 판을 완주한다.
RPG_MODEL=fake

# 한 세션의 모델 호출 상한. 전투 1판이 100~300 호출이다(기획서 §7.1).
# 넘으면 모델을 부르지 않고 Fake 로 전환하고 트레이스에 fallback 을 남긴다.
RPG_MAX_CALLS=300

# ─── Gemini (RPG_MODEL=gemini 일 때) ──────────────────────────────────
# Vertex(Agent Platform) 경로다. AI Studio API 키 경로가 아니다.
# 자격증명은 서비스 계정 JSON 이고 라이브러리가 직접 읽는다 — 파이썬 인자로
# 나르면 로그와 예외 메시지에 섞여 나갈 경로가 생긴다.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-sa.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# ─── Anthropic (RPG_MODEL=anthropic 일 때) ────────────────────────────
ANTHROPIC_API_KEY=

# ─── 백엔드 공유 시크릿 ────────────────────────────────────────────────
# 프론트(Next.js Route Handler)가 백엔드를 부를 때 다는 값. 브라우저에는
# 내려가지 않는다. 백엔드에 주입하는 값과 반드시 같아야 한다.
#
# **반드시 ASCII 여야 한다.** HTTP 헤더 값은 ASCII 만 허용되고,
# hmac.compare_digest 는 양쪽이 같은 비ASCII 문자열이어도 TypeError 로 죽는다.
#
# **비워 둔다.** 예시 값을 적어 두면 그대로 복사돼 배포로 나간다:
#   openssl rand -base64 32 | tr -d '/+='
BACKEND_SHARED_SECRET=

# ─── 저장 위치 ─────────────────────────────────────────────────────────
RPG_RUNS_DIR=runs
RPG_EXPERIMENTS_DIR=eval/out

# 판이 사람 눈에 보이는 속도로 흐르게 한다(초/판단). 0 이면 최고 속도.
# 비워 두면 Fake 는 0.2, 실모델은 0 이다(select.FAKE_PACE_S) — 그래야 뿔피리를
# 누를 시간이 생긴다(기획서 v3 §8.2). 굳이 덮어쓸 때만 적는다.
# RPG_PACE_S=0.2
